# cookie 文件路径（默认 ~/.goofish-cli/cookies.json）
GOOFISH_COOKIES_PATH=~/.goofish-cli/cookies.json

# 写操作限流：每分钟允许次数（默认 1，防风控）
GOOFISH_WRITE_RPM=1

# 风控熔断时长（分钟）
GOOFISH_CIRCUIT_BREAK_MINUTES=10

# 日志等级
GOOFISH_LOG_LEVEL=INFO

# ── 常驻 Chrome 窗口（v0.4.1+，浏览器命令共用；首次 `goofish browser open` 后登录闲鱼）──

# 浏览器模式：auto=优先常驻窗口、失败降级临时档（默认）；persistent=只用常驻（失败报错）；temp=只用临时档（旧行为）
GOOFISH_BROWSER_MODE=auto

# 常驻窗口调试端口（固定、只绑 127.0.0.1，不对外暴露；固定端口不影响风控）
GOOFISH_CHROME_CDP_PORT=37821

# 常驻窗口 profile 目录（登录态/缓存/设备身份都持久在这里，勿随手删）
GOOFISH_CHROME_PROFILE=~/.goofish-cli/chrome-profile

# Chrome 可执行文件路径（默认 macOS 系统 Chrome）
GOOFISH_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 连不上常驻窗口时是否自动拉起（0=只连不起，改用临时档）
GOOFISH_CHROME_AUTOSTART=1

# 标签策略：1=操作完保留标签（默认，便于查看结果、手动关闭）；0=自动关闭（旧行为）
GOOFISH_KEEP_TAB=1
